# Copy to .env to override local-stack defaults (all optional).
API_PORT=8000
NATS_PORT=4222
S3_PORT=8333
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686
WORKER_REPLICAS=2
# Comma-separated SHA-256 digests of accepted API keys. Generate a key + digest with: uv run eye-blink keygen
EB_API_KEY_HASHES=
# Set to send traces to Jaeger:  http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Blink signal: blendshape (default), ear or max. The synthetic test videos need ear (see docs/MODEL_CARD.md)
EB_SIGNAL=blendshape
